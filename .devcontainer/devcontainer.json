{
  // Codespace for Lab 4 – Rayfin with GitHub Copilot.
  // Participants never need to edit this file.
  "name": "Rayfin App Labs",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Ask for at least a 4-core machine; npm install and Vite builds are slow on 2 cores.
  "hostRequirements": { "cpus": 4 },

  // Codespaces has no OS keychain, so let the Rayfin CLI store its sign-in token
  // in a file. The file stays inside each participant's private codespace and is
  // deleted with it.
  "containerEnv": {
    "RAYFIN_ENCRYPTION_FALLBACK_ENABLED": "true"
  },

  // Runs during the prebuild, so its result is baked into every participant's codespace.
  // Updates the template's Rayfin packages to the latest versions (Fabric static hosting
  // needs Rayfin CLI 1.35.1 or later). The installs also fill the npm cache, so the
  // Lab 4 bootstrap is fast. node_modules is removed so the bootstrap does not copy it.
  "updateContentCommand": "cd template/field-services-app && npm install --save-dev --no-audit --no-fund @microsoft/rayfin-cli@latest @microsoft/rayfin-mcp@latest && npm install --no-audit --no-fund @microsoft/rayfin-client@latest @microsoft/rayfin-core@latest @microsoft/rayfin-data@latest @microsoft/rayfin-auth-provider-fabric@latest && rm -rf node_modules",

  // Runs once when a participant's codespace is created.
  "postCreateCommand": "bash .devcontainer/welcome.sh",

  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "git.autofetch": false
      }
    }
  }
}